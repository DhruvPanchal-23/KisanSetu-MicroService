# Copy to .env and replace this placeholder with a randomly generated secret.
# Node: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-before-starting
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
VITE_API_URL=/api
# Leave blank to keep using SQLite. Store the Atlas database-user URI only in .env.
MONGODB_URI=
MONGODB_DB=kisansetu
